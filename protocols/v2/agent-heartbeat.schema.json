{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://healer.internal/protocols/v2/agent-heartbeat.schema.json",
  "title": "agent.heartbeat payload v2",
  "description": "Periodic basic metrics snapshot pushed directly from an Agent to the Control Plane over the open WebSocket. Also what proves the connection is alive — see docs/agent-protocol.md's online/offline rules.",
  "type": "object",
  "required": ["cpu_percent", "memory_percent", "disk_percent"],
  "properties": {
    "cpu_percent": { "type": "number", "minimum": 0, "maximum": 100 },
    "memory_percent": { "type": "number", "minimum": 0, "maximum": 100 },
    "disk_percent": { "type": "number", "minimum": 0, "maximum": 100 },
    "instances": {
      "type": "array",
      "description": "Per-instance status known to this agent at heartbeat time.",
      "items": {
        "type": "object",
        "required": ["instance_id", "status"],
        "properties": {
          "instance_id": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["running", "stopped", "starting", "unhealthy", "unknown"]
          },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
