# Healer V1 — environment configuration
# Copy to .env and fill in real values. Nothing in this file is a usable secret.

# --- General ---
HEALER_ENV=development

# --- PostgreSQL ---
POSTGRES_USER=healer
POSTGRES_PASSWORD=changeme
POSTGRES_DB=healer
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://healer:changeme@postgres:5432/healer

# --- Redis (durable job queue backend) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Control Plane API (FastAPI) ---
CONTROL_PLANE_HOST=0.0.0.0
CONTROL_PLANE_PORT=8000
CONTROL_PLANE_SECRET_KEY=change-me-dev-secret
CONTROL_PLANE_PUBLIC_URL=http://localhost:8000

# --- Dashboard (Next.js) ---
NEXT_PUBLIC_CONTROL_PLANE_URL=http://localhost:8000
DASHBOARD_PORT=3000

# --- Gateway Manager (restricted, internal-only service) ---
# Must never be exposed on a public interface or reachable from the dashboard directly.
GATEWAY_MANAGER_HOST=127.0.0.1
GATEWAY_MANAGER_PORT=8100
GATEWAY_MANAGER_SHARED_SECRET=change-me-internal-secret

# --- Agent (outbound secure WebSocket over HTTPS) ---
AGENT_CONTROL_PLANE_WS_URL=wss://localhost:8000/ws/agent
AGENT_ENROLLMENT_TOKEN=change-me-enrollment-token

# --- Certificates (existing filesystem CRT/KEY paths only — no ACME) ---
DEFAULT_CERT_PATH=/etc/healer/certs/ritrjpm.edu.in.crt
DEFAULT_KEY_PATH=/etc/healer/certs/ritrjpm.edu.in.key
